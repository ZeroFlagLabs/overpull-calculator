           <item><widget class="QLabel" name="assumptions_heading_0"><property name="text"><string>Scope</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_0"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Estimates axial overpull capacity of a uniform annular or solid circular cross-section under direct tension.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><spacer name="assumptionsSectionGap1"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="assumptions_heading_1"><property name="text"><string>Calculation basis</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_1"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;• Metal area = π/4 × (OD² − ID²).&lt;/p&gt;&lt;p&gt;• Allowable stress = material yield strength × design factor (0 &amp;lt; f ≤ 1).&lt;/p&gt;&lt;p&gt;• Maximum overpull = allowable stress × metal area, rounded to the nearest lbf.&lt;/p&gt;&lt;p&gt;• Use minimum OD and maximum ID; ID = 0 represents a solid bar. Units: psi, in and lbf.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><spacer name="assumptionsSectionGap2"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="assumptions_heading_2"><property name="text"><string>Interpretation</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_2"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;• Design factor is a multiplier of yield strength, not a conventional safety factor divisor. For example, 2/3 corresponds to a safety factor of 1.5.&lt;/p&gt;&lt;p&gt;• Assumes uniform axial stress. Excludes stress concentrations, threads, combined loading, fatigue and other failure modes. Not a substitute for detailed design verification.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
